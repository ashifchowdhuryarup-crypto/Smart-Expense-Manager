{
  "entities": {
    "Transaction": {
      "title": "Transaction",
      "description": "Income or expense transaction record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["income", "expense"] },
        "amount": { "type": "number" },
        "category": { "type": "string", "maxLength": 64 },
        "description": { "type": "string", "maxLength": 256 },
        "date": { "type": "string", "maxLength": 32 },
        "paymentMethod": { "type": "string", "maxLength": 64 },
        "notes": { "type": "string", "maxLength": 512 },
        "tags": { "type": "array" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "type", "amount", "category", "description", "date"]
    },
    "Budget": {
      "title": "Budget",
      "description": "Monthly budget limit for a category",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "category": { "type": "string", "maxLength": 64 },
        "monthlyLimit": { "type": "number" },
        "month": { "type": "string", "maxLength": 16 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "category", "monthlyLimit", "month"]
    },
    "SavingsGoal": {
      "title": "SavingsGoal",
      "description": "Financial savings target and tracked contributions",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 128 },
        "targetAmount": { "type": "number" },
        "currentAmount": { "type": "number" },
        "targetDate": { "type": "string", "maxLength": 32 },
        "category": { "type": "string", "maxLength": 64 },
        "color": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "title", "targetAmount", "currentAmount"]
    },
    "UserSettings": {
      "title": "UserSettings",
      "description": "User preferences, selected currency, and budget options",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "currency": { "type": "string", "maxLength": 8 },
        "theme": { "type": "string", "maxLength": 16 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "currency"]
    }
  },
  "firestore": {
    "/users/{userId}/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "User specific income and expense records"
    },
    "/users/{userId}/budgets/{budgetId}": {
      "schema": { "$ref": "#/entities/Budget" },
      "description": "Category monthly expenditure caps and alerts"
    },
    "/users/{userId}/savingsGoals/{goalId}": {
      "schema": { "$ref": "#/entities/SavingsGoal" },
      "description": "Savings goals with current progress"
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": { "$ref": "#/entities/UserSettings" },
      "description": "User preference settings such as active currency"
    }
  }
}
